+    // Caller modules: run kernels that are not FORGE's own (an application's PTX / AMDGPU code object) on this
+    // runtime's context and stream, next to its own work. A module stays loaded until unload_module() or the
+    // runtime's destruction. Arguments are passed as cuLaunchKernel / hipModuleLaunchKernel take them.
+    // load_module: nullptr + reason when the driver rejects the image (e.g. PTX for a newer sm, another gfx).
+    void* load_module(std::string_view image, std::string* why = nullptr) {
+        std::lock_guard lk(mu_); bind();
+        std::string img(image);   // PTX text must be NUL-terminated
+        void* m = nullptr;
+        if (int r = f_.load(&m, img.data()); r != 0 || !m) { if (why) *why = std::string(api_name(api_)) + ": module load failed (" + std::to_string(r) + ")"; return nullptr; }
+        user_mods_.push_back(m); return m;
+    }
+    void unload_module(void* m) {
+        std::lock_guard lk(mu_); bind(); flush();
+        if (auto it = std::find(user_mods_.begin(), user_mods_.end(), m); it != user_mods_.end()) { user_mods_.erase(it); if (f_.unload) f_.unload(m); }
+    }
+    void* module_function(void* m, const std::string& name) {   // nullptr when the module has no such kernel
+        std::lock_guard lk(mu_); bind();
+        void* f = nullptr; return f_.get_fn(&f, m, name.c_str()) == 0 ? f : nullptr;
+    }
+    // Most dynamic shared memory one block can be given: CUDA's opt-in limit (48 KB when the driver cannot say);
+    // HIP: 64 KB, the LDS per workgroup of current AMD GPUs.
+    std::size_t max_dynamic_smem() {
+        if (api_ != api::cuda) return 64 << 10;
+        std::lock_guard lk(mu_); bind();
+        int v = 0;
+        if (f_.dev_attr && f_.dev_attr(&v, 97 /* MAX_SHARED_MEMORY_PER_BLOCK_OPTIN */, dev_) == 0 && v > 0) return std::size_t(v);
+        return 48 << 10;
+    }
+    // Let fn launch with `bytes` of dynamic shared memory (CUDA: cuFuncSetAttribute above 48 KB). false = not possible.
+    bool set_dynamic_smem(void* fn, std::size_t bytes) {
+        if (bytes > max_dynamic_smem()) return false;
+        if (api_ != api::cuda || bytes <= (48u << 10)) return true;
+        std::lock_guard lk(mu_); bind();
+        return f_.func_attr && f_.func_attr(fn, 8 /* MAX_DYNAMIC_SHARED_SIZE_BYTES */, int(bytes)) == 0;
+    }
+    // Queue fn on the runtime's stream; wait() (or a download) blocks until it has run. Throws on a launch error.
+    void launch_kernel(void* fn, const unsigned grid[3], const unsigned block[3], unsigned smem, void** args) {
+        std::lock_guard lk(mu_); bind(); begin_op();
+        ck(launch_s(fn, grid[0], grid[1], grid[2], block[0], block[1], block[2], smem, stream_, args, nullptr), "launch");
+    }
