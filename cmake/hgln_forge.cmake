# Obtain FORGE, apply HGLN's patches (third_party/forge-patches/*.patch, in name order) to a copy in the build tree,
# and add it as a subproject with its own tests, apps and examples off.
set(_forge_src ${CMAKE_BINARY_DIR}/_deps/forge-src)
file(GLOB HGLN_FORGE_PATCHES ${PROJECT_SOURCE_DIR}/third_party/forge-patches/*.patch)
list(SORT HGLN_FORGE_PATCHES)
set(_stamp_want "${FORGE_SOURCE_DIR}|${FORGE_GIT_TAG}")
foreach(p ${HGLN_FORGE_PATCHES})
  file(SHA256 ${p} _h)
  string(APPEND _stamp_want "|${_h}")
endforeach()
set(_stamp_have "")
if(EXISTS ${_forge_src}/.hgln_stamp)
  file(READ ${_forge_src}/.hgln_stamp _stamp_have)
endif()
if(NOT _stamp_have STREQUAL _stamp_want)
  file(REMOVE_RECURSE ${_forge_src})
  if(FORGE_SOURCE_DIR)
    message(STATUS "HGLN: copying FORGE from ${FORGE_SOURCE_DIR}")
    file(COPY ${FORGE_SOURCE_DIR}/ DESTINATION ${_forge_src} PATTERN .git EXCLUDE PATTERN build EXCLUDE)
  else()
    find_package(Git REQUIRED)
    message(STATUS "HGLN: fetching FORGE ${FORGE_GIT_TAG}")
    execute_process(COMMAND ${GIT_EXECUTABLE} init -q ${_forge_src} RESULT_VARIABLE r1)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${_forge_src} fetch -q --depth 1 ${FORGE_GIT_REPOSITORY} ${FORGE_GIT_TAG} RESULT_VARIABLE r2)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${_forge_src} checkout -q FETCH_HEAD RESULT_VARIABLE r3)
    if(r1 OR r2 OR r3)
      message(FATAL_ERROR "HGLN: could not fetch FORGE ${FORGE_GIT_TAG} from ${FORGE_GIT_REPOSITORY} (set FORGE_SOURCE_DIR to a local checkout)")
    endif()
  endif()
  foreach(p ${HGLN_FORGE_PATCHES})
    message(STATUS "HGLN: applying ${p}")
    execute_process(COMMAND patch -p1 -N -i ${p} WORKING_DIRECTORY ${_forge_src} RESULT_VARIABLE r)
    if(r)
      message(FATAL_ERROR "HGLN: patch ${p} does not apply to this FORGE (pinned: ${FORGE_GIT_TAG})")
    endif()
  endforeach()
  file(WRITE ${_forge_src}/.hgln_stamp "${_stamp_want}")
endif()
set(FORGE_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(FORGE_BUILD_APPS OFF CACHE BOOL "" FORCE)
set(FORGE_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
add_subdirectory(${_forge_src} ${CMAKE_BINARY_DIR}/_deps/forge-build EXCLUDE_FROM_ALL)
