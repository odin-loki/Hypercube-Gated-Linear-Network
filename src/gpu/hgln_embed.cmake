# hgln_embed.cmake - embed HGLN's device images into a C++ header (run with cmake -P at build time; see
# cmake/hgln_gpu.cmake). Copyright (C) Odin Loch. GNU AGPL v3.0 or later (see LICENSE).
#   -DLIST=<file>  one image per line: "<api 0=cuda 1=hip>|<real bytes 8|4>|<arch name>|<path>"
#   -DOUT=<header> -DNM=<llvm-nm, optional>
# Every image is checked for unresolved external calls first: PTX must have no ".extern .func"; an AMDGPU code object
# must have no undefined symbols (llvm-nm -u). A failing check fails the build.
file(STRINGS "${LIST}" _lines)
set(_arrays "")
set(_table "")
set(_n 0)
foreach(_l IN LISTS _lines)
  if(_l STREQUAL "")
    continue()
  endif()
  string(REPLACE "|" ";" _f "${_l}")
  list(GET _f 0 _api)
  list(GET _f 1 _real)
  list(GET _f 2 _arch)
  list(GET _f 3 _path)
  if(_api EQUAL 0)
    file(READ "${_path}" _txt)
    string(FIND "${_txt}" ".extern .func" _x)
    if(NOT _x EQUAL -1)
      message(FATAL_ERROR "HGLN: ${_path} has unresolved external calls (.extern .func)")
    endif()
  elseif(NM)
    execute_process(COMMAND "${NM}" -u "${_path}" OUTPUT_VARIABLE _und RESULT_VARIABLE _r)
    string(STRIP "${_und}" _und)
    if(_r OR NOT _und STREQUAL "")
      message(FATAL_ERROR "HGLN: ${_path} has undefined symbols: ${_und}")
    endif()
  endif()
  file(READ "${_path}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _size "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
  string(REGEX REPLACE "((0x..,){40})" "\\1\n" _hex "${_hex}")
  string(APPEND _arrays "// ${_path}\ninline constexpr unsigned char img${_n}[] = {\n${_hex}0x00};   // NUL-terminated (PTX is text)\n")
  string(APPEND _table "  {${_api}, ${_real}, \"${_arch}\", img${_n}, ${_size}},\n")
  math(EXPR _n "${_n} + 1")
endforeach()
if(_n EQUAL 0)
  set(_table "  {-1, 0, \"\", nullptr, 0},\n")
endif()
set(_text "// generated by src/gpu/hgln_embed.cmake -- do not edit
#pragma once
#include <cstddef>
namespace hgln::gpu::images {
struct image { int api; int real; const char* arch; const unsigned char* data; std::size_t size; };   // api 0 cuda, 1 hip; real: sizeof
${_arrays}inline constexpr image table[] = {
${_table}};
inline constexpr std::size_t count = ${_n};
}  // namespace hgln::gpu::images
")
file(WRITE "${OUT}" "${_text}")
